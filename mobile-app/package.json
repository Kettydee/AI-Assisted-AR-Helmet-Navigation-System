{
  "name": "ar-helmet-nav",
  "private": true,
  "version": "1.2.0",
  "description": "Companion app for the AI-Assisted AR Helmet Navigation System: BLE link to the ESP32-S3 HUD, incoming-call relay, crash/SOS alerts.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \"dist-test/**/*.test.js\""
  },
  "dependencies": {
    "@expo-google-fonts/exo-2": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "^57.0.6",
    "expo-constants": "~57.0.19",
    "expo-contacts": "~57.0.6",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.23",
    "expo-speech": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-task-manager": "^57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-fast-tflite": "3.0.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.37.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-resizer": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite"
        ]
      }
    }
  }
}
